{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-compound-bash.mjs\" || exit 2"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Read",
      "Glob",
      "Grep",
      "Edit(./**)",
      "Write(./**)",
      "Bash"
    ],
    "ask": [
      "Edit(**/.claude/settings.json)",
      "Write(**/.claude/settings.json)",
      "Edit(**/.claude/hooks/**)",
      "Write(**/.claude/hooks/**)",
      "Edit(**/scripts/harness/**)",
      "Write(**/scripts/harness/**)",
      "Edit(**/opencode.json)",
      "Write(**/opencode.json)",
      "Edit(**/.codex/**)",
      "Write(**/.codex/**)",
      "Edit(**/.opencode/plugins/**)",
      "Write(**/.opencode/plugins/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.linkedin.token.json)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(~/.ssh/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./.linkedin.token.json)",
      "Edit(./**/*.pem)",
      "Edit(./**/*.key)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./.linkedin.token.json)",
      "Write(./**/*.pem)",
      "Write(./**/*.key)",
      "Bash(* .env)",
      "Bash(* .env *)",
      "Bash(* .env.*)",
      "Bash(*/.env)",
      "Bash(*/.env *)",
      "Bash(*/.env.*)",
      "Bash(*=.env*)",
      "Bash(*.linkedin.token.json*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main*)",
      "Bash(git push * staging)",
      "Bash(git push * staging *)",
      "Bash(git push *:staging*)",
      "Bash(git push * dev)",
      "Bash(git push * dev *)",
      "Bash(git push *:dev)",
      "Bash(git push *:dev *)",
      "Bash(git -C * push * main)",
      "Bash(git -C * push * main *)",
      "Bash(git -C * push *:main*)",
      "Bash(git -C * push * staging)",
      "Bash(git -C * push * staging *)",
      "Bash(git -C * push *:staging*)",
      "Bash(git -C * push * dev)",
      "Bash(git -C * push * dev *)",
      "Bash(git -C * push *:dev)",
      "Bash(git -C * push *:dev *)",
      "Bash(chmod 777*)",
      "Bash(chmod -R 777*)",
      "Bash(chmod * 777*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf / *)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -fr /)",
      "Bash(rm -fr / *)",
      "Bash(rm -fr ~)",
      "Bash(rm -fr ~/)",
      "Bash(rm -fr $HOME)",
      "Bash(rm -rf --no-preserve-root*)",
      "Bash(sudo *)",
      "Bash(rtk git push * main)",
      "Bash(rtk git push * main *)",
      "Bash(rtk git push *:main*)",
      "Bash(rtk git push * staging)",
      "Bash(rtk git push * staging *)",
      "Bash(rtk git push *:staging*)",
      "Bash(rtk git push * dev)",
      "Bash(rtk git push * dev *)",
      "Bash(rtk git push *:dev)",
      "Bash(rtk git push *:dev *)",
      "Bash(rtk git -C * push * main)",
      "Bash(rtk git -C * push * main *)",
      "Bash(rtk git -C * push *:main*)",
      "Bash(rtk git -C * push * staging)",
      "Bash(rtk git -C * push * staging *)",
      "Bash(rtk git -C * push *:staging*)",
      "Bash(rtk git -C * push * dev)",
      "Bash(rtk git -C * push * dev *)",
      "Bash(rtk git -C * push *:dev)",
      "Bash(rtk git -C * push *:dev *)",
      "Bash(rtk chmod 777*)",
      "Bash(rtk chmod -R 777*)",
      "Bash(rtk chmod * 777*)",
      "Bash(rtk rm -rf /)",
      "Bash(rtk rm -rf / *)",
      "Bash(rtk rm -rf ~)",
      "Bash(rtk rm -rf ~/)",
      "Bash(rtk rm -rf $HOME)",
      "Bash(rtk rm -fr /)",
      "Bash(rtk rm -fr / *)",
      "Bash(rtk rm -fr ~)",
      "Bash(rtk rm -fr ~/)",
      "Bash(rtk rm -fr $HOME)",
      "Bash(rtk rm -rf --no-preserve-root*)",
      "Bash(rtk sudo *)",
      "Bash(rtk proxy git push * main)",
      "Bash(rtk proxy git push * main *)",
      "Bash(rtk proxy git push *:main*)",
      "Bash(rtk proxy git push * staging)",
      "Bash(rtk proxy git push * staging *)",
      "Bash(rtk proxy git push *:staging*)",
      "Bash(rtk proxy git push * dev)",
      "Bash(rtk proxy git push * dev *)",
      "Bash(rtk proxy git push *:dev)",
      "Bash(rtk proxy git push *:dev *)",
      "Bash(rtk proxy git -C * push * main)",
      "Bash(rtk proxy git -C * push * main *)",
      "Bash(rtk proxy git -C * push *:main*)",
      "Bash(rtk proxy git -C * push * staging)",
      "Bash(rtk proxy git -C * push * staging *)",
      "Bash(rtk proxy git -C * push *:staging*)",
      "Bash(rtk proxy git -C * push * dev)",
      "Bash(rtk proxy git -C * push * dev *)",
      "Bash(rtk proxy git -C * push *:dev)",
      "Bash(rtk proxy git -C * push *:dev *)",
      "Bash(rtk proxy chmod 777*)",
      "Bash(rtk proxy chmod -R 777*)",
      "Bash(rtk proxy chmod * 777*)",
      "Bash(rtk proxy rm -rf /)",
      "Bash(rtk proxy rm -rf / *)",
      "Bash(rtk proxy rm -rf ~)",
      "Bash(rtk proxy rm -rf ~/)",
      "Bash(rtk proxy rm -rf $HOME)",
      "Bash(rtk proxy rm -fr /)",
      "Bash(rtk proxy rm -fr / *)",
      "Bash(rtk proxy rm -fr ~)",
      "Bash(rtk proxy rm -fr ~/)",
      "Bash(rtk proxy rm -fr $HOME)",
      "Bash(rtk proxy rm -rf --no-preserve-root*)",
      "Bash(rtk proxy sudo *)"
    ]
  }
}

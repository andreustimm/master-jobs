{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Read",
      "Glob",
      "Grep",
      "Bash(git:*)",
      "Bash(rtk git:*)",
      "Bash(gh:*)",
      "Bash(rtk gh:*)",
      "Bash(pnpm:*)",
      "Bash(rtk pnpm:*)",
      "Bash(rtk proxy:*)",
      "Bash(rtk gain:*)",
      "Bash(npx drizzle-kit:*)",
      "Bash(node:*)",
      "Bash(python3:*)",
      "Bash(supabase db query:*)",
      "Bash(curl -s:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(diff:*)",
      "Bash(jq:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(test:*)",
      "Bash(stat:*)",
      "Bash(which:*)",
      "Bash(date:*)",
      "Bash(pwd)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(touch:*)",
      "Bash(xargs:*)",
      "Bash(tee:*)",
      "Bash(ps:*)",
      "Bash(lsof:*)"
    ],
    "ask": [
      "Bash(*git*push*--force*)",
      "Bash(*git*push* -f*)",
      "Bash(*git*push* +*)",
      "Bash(*git*push*--mirror*)",
      "Bash(*git*push*--prune*)",
      "Bash(*git*push*--no-verify*)",
      "Bash(*git*reset*--hard*)",
      "Bash(*git*reset*--merge*)",
      "Bash(*git*clean*)",
      "Bash(*git*checkout*-- *)",
      "Bash(*git*checkout .*)",
      "Bash(*git*checkout*-f*)",
      "Bash(*git*restore*)",
      "Bash(*git*stash*drop*)",
      "Bash(*git*stash*clear*)",
      "Bash(*git*worktree*remove*--force*)",
      "Bash(*git*worktree*remove*-f*)",
      "Bash(*git*filter-branch*)",
      "Bash(*git*filter-repo*)",
      "Bash(*git*update-ref*-d*)",
      "Bash(*git*reflog*expire*)",
      "Bash(*git*gc*--prune*)",
      "Bash(*gh*api*DELETE*)",
      "Bash(*gh*api*refs/heads/main*)",
      "Bash(*gh*api*refs/heads/staging*)",
      "Bash(*gh*api*refs/heads/dev*)",
      "Bash(*gh*repo*delete*)",
      "Bash(*gh*release*delete*)",
      "Bash(find*-delete*)",
      "Bash(find*-exec*rm*)",
      "Bash(xargs*rm*)",
      "Bash(rm:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(kill:*)",
      "Bash(pkill:*)",
      "Bash(brew:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.linkedin.token.json)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(~/.ssh/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./.linkedin.token.json)",
      "Edit(./**/*.pem)",
      "Edit(./**/*.key)",
      "Bash(* .env)",
      "Bash(* .env *)",
      "Bash(* .env.*)",
      "Bash(*/.env)",
      "Bash(*/.env *)",
      "Bash(*/.env.*)",
      "Bash(*=.env*)",
      "Bash(*.linkedin.token.json*)",
      "Bash(*git*push* main)",
      "Bash(*git*push* main *)",
      "Bash(*git*push*:main*)",
      "Bash(*git*push* staging)",
      "Bash(*git*push* staging *)",
      "Bash(*git*push*:staging*)",
      "Bash(*git*push* dev)",
      "Bash(*git*push* dev *)",
      "Bash(*git*push*:dev)",
      "Bash(*git*push*:dev *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -fr /*)",
      "Bash(rm -fr ~*)",
      "Bash(rm -rf --no-preserve-root*)",
      "Bash(sudo *)"
    ]
  }
}

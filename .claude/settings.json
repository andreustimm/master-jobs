    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.linkedin.token.json)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(~/.ssh/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./.linkedin.token.json)",
      "Edit(./**/*.pem)",
      "Edit(./**/*.key)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./.linkedin.token.json)",
      "Write(./**/*.pem)",
      "Write(./**/*.key)",
      "Bash(* .env)",
      "Bash(* .env *)",
      "Bash(* .env.*)",
      "Bash(*/.env)",
      "Bash(*/.env *)",
      "Bash(*/.env.*)",
      "Bash(*=.env*)",
      "Bash(*.linkedin.token.json*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main*)",
      "Bash(git push * staging)",
      "Bash(git push * staging *)",
      "Bash(git push *:staging*)",
      "Bash(git push * dev)",
      "Bash(git push * dev *)",
      "Bash(git push *:dev)",
      "Bash(git push *:dev *)",
      "Bash(git -C * push * main)",
      "Bash(git -C * push * main *)",
      "Bash(git -C * push *:main*)",
      "Bash(git -C * push * staging)",
      "Bash(git -C * push * staging *)",
      "Bash(git -C * push *:staging*)",
      "Bash(git -C * push * dev)",
      "Bash(git -C * push * dev *)",
      "Bash(git -C * push *:dev)",
      "Bash(git -C * push *:dev *)",
      "Bash(chmod 777*)",
      "Bash(chmod -R 777*)",
      "Bash(chmod * 777*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -fr /*)",
      "Bash(rm -fr ~*)",
      "Bash(rm -rf --no-preserve-root*)",

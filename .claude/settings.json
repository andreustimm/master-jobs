      "Edit(./.env.*)",
      "Edit(./.linkedin.token.json)",
      "Edit(./**/*.pem)",
      "Edit(./**/*.key)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./.linkedin.token.json)",
      "Write(./**/*.pem)",
      "Write(./**/*.key)",

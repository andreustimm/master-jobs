      "Bash(git push *:dev)",
      "Bash(git push *:dev *)",
      "Bash(git -C * push * main)",
      "Bash(git -C * push * main *)",
      "Bash(git -C * push *:main*)",
      "Bash(git -C * push * staging)",
      "Bash(git -C * push * staging *)",
      "Bash(git -C * push *:staging*)",
      "Bash(git -C * push * dev)",
      "Bash(git -C * push * dev *)",
      "Bash(git -C * push *:dev)",
      "Bash(git -C * push *:dev *)",
      "Bash(chmod 777*)",
      "Bash(chmod -R 777*)",
      "Bash(chmod * 777*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -fr /*)",
      "Bash(rm -fr ~*)",
      "Bash(rm -rf --no-preserve-root*)",
      "Bash(sudo *)",
      "Bash(rtk git push * main)",
      "Bash(rtk git push * main *)",
      "Bash(rtk git push *:main*)",
      "Bash(rtk git push * staging)",
      "Bash(rtk git push * staging *)",
      "Bash(rtk git push *:staging*)",
      "Bash(rtk git push * dev)",
      "Bash(rtk git push * dev *)",
      "Bash(rtk git push *:dev)",
      "Bash(rtk git push *:dev *)",
      "Bash(rtk git -C * push * main)",
      "Bash(rtk git -C * push * main *)",
      "Bash(rtk git -C * push *:main*)",
      "Bash(rtk git -C * push * staging)",
      "Bash(rtk git -C * push * staging *)",
      "Bash(rtk git -C * push *:staging*)",
      "Bash(rtk git -C * push * dev)",
      "Bash(rtk git -C * push * dev *)",
      "Bash(rtk git -C * push *:dev)",
      "Bash(rtk git -C * push *:dev *)",

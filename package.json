{
  "name": "master-jobs",
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "private": true,
  "type": "module",
  "description": "Job sourcing, fit scoring, application pipeline and LinkedIn positioning cockpit.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "jho": "node --experimental-strip-types --no-warnings --env-file-if-exists=.env src/cli.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "pnpm jho db seed",
    "sync": "pnpm jho jobs sync",
    "score": "pnpm jho jobs score",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && vitest run --coverage",
    "test:e2e": "node tests/e2e/run-isolated.mjs",
    "test:e2e:external": "node tests/e2e/setup.mjs && node tests/e2e/ui.mjs",
    "prebuild": "node scripts/sw-version.mjs",
    "icons": "node scripts/make-icons.mjs",
    "sw": "node scripts/sw-version.mjs",
    "predev": "node scripts/sw-version.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@libsql/client": "^0.17.4",
    "@replit/codemirror-vim": "^6.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "commander": "^15.0.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.32.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0"
    }
  }
}

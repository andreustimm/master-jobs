{
  "name": "master-jobs",
  "version": "1.20.8",
  "packageManager": "pnpm@10.28.0",
  "private": true,
  "type": "module",
  "description": "Job sourcing, fit scoring, application pipeline and LinkedIn positioning cockpit.",
  "engines": {
    "node": "^24.19.0"
  },
  "scripts": {
    "prepare": "node scripts/configure-git-hooks.mjs",
    "dev": "next dev --turbopack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "jho": "node --experimental-strip-types --no-warnings --env-file-if-exists=.env src/cli.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:rehearse-production": "node --no-warnings scripts/migration/rehearse-production.ts",
    "db:import-local": "node --no-warnings --env-file-if-exists=.env scripts/migration/import-local.ts",
    "db:import-production": "node --no-warnings scripts/migration/production.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "pnpm jho db seed",
    "sync": "pnpm jho jobs sync",
    "score": "pnpm jho jobs score",
    "typecheck": "tsc --noEmit",
    "worktrees": "node scripts/worktree-status.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm check:release-ready && pnpm check:qa-tracker && pnpm typecheck && vitest run --coverage && pnpm test:qa-skills",
    "check:release-ready": "node --experimental-strip-types --no-warnings scripts/release/validar-changelogs.ts",
    "check:qa-tracker": "PYTHONDONTWRITEBYTECODE=1 python3 .claude/skills/qa-report/scripts/materialize_state.py docs/qa",
    "test:qa-skills": "PYTHONDONTWRITEBYTECODE=1 python3 .claude/skills/qa-report/tests/test_scripts.py",
    "test:e2e": "node tests/e2e/run-isolated.mjs",
    "test:e2e:external": "node tests/e2e/setup.mjs && node tests/e2e/ui.mjs && node tests/e2e/a11y.mjs",
    "test:pwa-browser": "JHO_PWA_BROWSER_TESTS=1 vitest run tests/pwa-chrome.test.ts",
    "check:deployed-css": "node scripts/check-deployed-css.mjs",
    "qa:browser:install": "agent-browser install",
    "changelog:build": "node scripts/build-changelog.ts",
    "pretypecheck": "pnpm changelog:build",
    "pretest": "pnpm changelog:build",
    "pretest:watch": "pnpm changelog:build",
    "pretest:coverage": "pnpm changelog:build",
    "prebuild": "node scripts/sw-version.mjs && pnpm changelog:build",
    "icons": "node scripts/make-icons.mjs",
    "sw": "node scripts/sw-version.mjs",
    "predev": "node scripts/sw-version.mjs && pnpm changelog:build",
    "test:coverage": "vitest run --coverage",
    "perf:jobs": "JHO_PERF=1 vitest run tests/perf-jobs-baseline.test.ts",
    "tasks": "node scripts/tasks/cli.ts",
    "tasks:setup": "node scripts/tasks/setup.ts",
    "test:tasks": "vitest run --config vitest.tasks.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@libsql/client": "^0.17.4",
    "@replit/codemirror-vim": "^6.4.0",
    "@sentry/nextjs": "^10.75.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "commander": "^15.0.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.33.0",
    "next": "^16.3.2",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "agent-browser": "0.26.0",
    "drizzle-kit": "^0.31.10",
    "playwright": "^1.62.1",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0"
    }
  }
}

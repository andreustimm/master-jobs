# generated dashboard — contains personal funnel data
dashboard.html

# agent worktrees
.claude/worktrees/

# Artefatos da skill `deep-review`: gerados por execução e retomáveis, nunca
# fonte. O relatório de cada rodada fica em `.deep-review/<alvo>/review.html`,
# e o estado que permite a revisão incremental, em `.deep-review/state.json`.
.deep-review/

# QA living docs — generated views & bulky evidence (source of truth:
# docs/qa/scenarios/ and the other authored files under docs/qa/).
docs/qa/state.csv
docs/qa/evidence/

# Derivado de scripts/sw-template.js pelo prebuild — a versão entra no nome dos
# caches, então o arquivo muda a cada release e não deve ser versionado.
public/sw.js
public/offline.html
.vercel
.env*

# QA living docs — generated views & bulky evidence (source of truth: docs/qa/scenarios/ etc.)
docs/qa/state.csv
docs/qa/evidence/

# Bytecode de Python. Os gates rodam os scripts das skills de QA com
# PYTHONDONTWRITEBYTECODE=1, mas quem os importa à mão sem essa variável deixava
# `__pycache__/` solto na árvore — e a revisão profunda conta arquivo não
# rastreado no hash que congela o checkout, então um `.pyc` perdido a obrigava a
# recomeçar a rodada.
__pycache__/

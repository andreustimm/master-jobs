# ---------------------------------------------------------------------------
# job-hunt-os — copy to .env.local and fill in. Both are gitignored.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Local dev: a plain SQLite file, no server required.
# Vercel/production: a Turso (libSQL) database — same driver, same SQL.
#   turso db create job-hunt-os && turso db show --url job-hunt-os
TURSO_DATABASE_URL=file:./data/jobs.db
TURSO_AUTH_TOKEN=

# --- Cron protection -------------------------------------------------------
# Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# --- LinkedIn official API (Share on LinkedIn / w_member_social) -----------
# https://developer.linkedin.com/ → create app → Products tab → enable:
#   * "Sign In with LinkedIn using OpenID Connect"  (gives `openid profile`)
#   * "Share on LinkedIn"                           (gives `w_member_social`)
# Both are self-serve. w_member_social needs NO partner review for posting to
# your own profile. Organization posting (w_organization_social) does.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback

# --- Optional job aggregators ---------------------------------------------
# Adzuna free tier: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Etiquette -------------------------------------------------------------
# Sent on every outbound request to public ATS endpoints.
JHO_USER_AGENT=job-hunt-os/0.1 (personal job search; +https://github.com/andreustimm)

# --- Obsidian export -------------------------------------------------------
JHO_VAULT_PATH=/Users/andreus/Documents/Obsidian Vault
JHO_REPORT_DIR=05_Interviews/LinkedIn

# Copie para .env e preencha. O .env é ignorado pelo Git.
#
# Contato do candidato. Fica fora do profile.yaml de propósito: aquele arquivo
# é versionado, e Git guarda histórico — publicar e remover depois não resolve.
JHO_CANDIDATE_EMAIL=voce@exemplo.com

# PostgreSQL obrigatório. Runtime usa uma role restrita, nunca a credencial DDL.
# Não fornecer produção a previews, testes ou ambientes de desenvolvimento.
#
# Supabase Production (exemplo; nunca copie valores reais para este arquivo):
# - runtime usa o pooler de transação, sem parâmetros na URL;
# - a migração usa o usuário postgres no host direto; scripts/migration/production-target.ts valida o projeto;
# - a senha precisa estar URL-encoded.
# DATABASE_URL=postgresql://<runtime-user>.<project-ref>:<senha-url-encoded>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
# DATABASE_CA_CERT=config/certs/supabase-ca.crt
# DATABASE_MIGRATION_URL=postgresql://postgres:<senha-url-encoded>@db.<project-ref>.supabase.co:5432/postgres
#
# No GitHub Actions, os secrets de produção são mapeados assim:
# SUPABASE_DATABASE_URL=postgresql://<runtime-user>.<project-ref>:<senha-url-encoded>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
# SUPABASE_MIGRATION_URL=postgresql://postgres:<senha-url-encoded>@db.<project-ref>.supabase.co:5432/postgres
# SUPABASE_DATABASE_URL -> DATABASE_URL (varredura/manutenção)
# SUPABASE_MIGRATION_URL -> DATABASE_MIGRATION_URL (workflow migrate)

# Ingestão (ADR 0021). Sem JHO_ENV o ambiente é tratado como preview e toda
# sincronização, captura e probe é recusada. Local só busca rede com opt-in.
# JHO_ENV=local
# JHO_INGESTION_OPT_IN=true

# Gmail (F-01). Somente leitura. Passo a passo em docs/email-ingestion.md.
# GMAIL_CLIENT_ID=...apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=

# LLM opcional (BYOK — a chave é sua, o custo é seu).
# Só o comando `jho analyze` usa, e ele pede confirmação antes de enviar.
# Envia o anúncio da vaga; NUNCA o currículo, o perfil ou o funil.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# JHO_LLM_PROVIDER=anthropic
# JHO_LLM_MODEL=

# Outros provedores pré-cadastrados (jho llm list). Só o que você usar.
# OPENROUTER_API_KEY=
# NVIDIA_API_KEY=            # free tier, chave começa com nvapi-
# OPENCODE_ZEN_API_KEY=      # modelos gratuitos, sem cartão
# OPENCODE_API_KEY=          # OpenCode Go

# ---------------------------------------------------------------------------
# Resend — e-mail transacional (recuperação de senha)
#
# As DUAS são necessárias. Só a chave, sem remetente, não configura nada: o
# Resend recusa envio sem um `from` de domínio verificado, e descobrir isso na
# hora do envio seria tarde.
#
# Sem elas o sistema continua funcionando: o link de recuperação vai para o
# terminal, com um aviso dizendo que nada foi enviado. É o suficiente para uma
# instalação de um operador só.
#
# A chave é gerada em resend.com/api-keys — nenhum agente pode criá-la por você.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=re_...
# RESEND_FROM=master-jobs@seu-dominio.com

# ---------------------------------------------------------------------------
# PostgreSQL local
#
# Use uma instância local isolada; nunca dados ou credenciais de produção.
# TLS é dispensado apenas em localhost/127.0.0.1/::1.
# ---------------------------------------------------------------------------
# O Compose local usa 5433 para não disputar a instância que já ocupa 5432.
# Production is PostgreSQL 17.6.1.x; keep local on the same major/minor.
# LOCAL_POSTGRES_IMAGE=supabase/postgres:17.6.1.171
# LOCAL_POSTGRES_PORT=5433
# LOCAL_POSTGRES_USER=supabase_admin
# LOCAL_POSTGRES_PASSWORD=master_jobs_local_only
# LOCAL_POSTGRES_DB=master_jobs_local
# DATABASE_URL=postgresql://supabase_admin:master_jobs_local_only@127.0.0.1:5433/master_jobs_local
# DATABASE_MIGRATION_URL=$DATABASE_URL
# Veja docs/engineering/local-postgres.md para subir, verificar e resetar.

# ---------------------------------------------------------------------------
# Cron da Vercel
#
# Protege /api/cron/recheck. SEM ela a rota responde 503 — fechada por omissão,
# porque um cron desprotegido é um botão de disparar requisições contra sites de
# terceiros que qualquer um aperta em laço.
#
# A Vercel envia este valor no cabeçalho `authorization` das chamadas agendadas.
# ---------------------------------------------------------------------------
# CRON_SECRET=

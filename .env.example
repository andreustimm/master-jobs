# Copie para .env e preencha. O .env é ignorado pelo Git.
#
# Contato do candidato. Fica fora do profile.yaml de propósito: aquele arquivo
# é versionado, e Git guarda histórico — publicar e remover depois não resolve.
JHO_CANDIDATE_EMAIL=voce@exemplo.com

# PostgreSQL obrigatório. Runtime usa role restrita, nunca a credencial DDL.
# Não fornecer produção a previews, testes ou ambientes de desenvolvimento.
# DATABASE_URL=postgresql://<runtime-user>:<senha-url-encoded>@<host>:5432/postgres
# DATABASE_CA_CERT=config/certs/supabase-ca.crt
# Só na estação do operador/CI de migração:
# DATABASE_MIGRATION_URL=postgresql://postgres.<ref>:<senha-url-encoded>@<pooler>:5432/postgres

# Gmail (F-01). Somente leitura. Passo a passo em docs/email-ingestion.md.
# GMAIL_CLIENT_ID=...apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=

# LLM opcional (BYOK — a chave é sua, o custo é seu).
# Só o comando `jho analyze` usa, e ele pede confirmação antes de enviar.
# Envia o anúncio da vaga; NUNCA o currículo, o perfil ou o funil.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# JHO_LLM_PROVIDER=anthropic
# JHO_LLM_MODEL=

# Outros provedores pré-cadastrados (jho llm list). Só o que você usar.
# OPENROUTER_API_KEY=
# NVIDIA_API_KEY=            # free tier, chave começa com nvapi-
# OPENCODE_ZEN_API_KEY=      # modelos gratuitos, sem cartão
# OPENCODE_API_KEY=          # OpenCode Go

# ---------------------------------------------------------------------------
# Resend — e-mail transacional (recuperação de senha)
#
# As DUAS são necessárias. Só a chave, sem remetente, não configura nada: o
# Resend recusa envio sem um `from` de domínio verificado, e descobrir isso na
# hora do envio seria tarde.
#
# Sem elas o sistema continua funcionando: o link de recuperação vai para o
# terminal, com um aviso dizendo que nada foi enviado. É o suficiente para uma
# instalação de um operador só.
#
# A chave é gerada em resend.com/api-keys — nenhum agente pode criá-la por você.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=re_...
# RESEND_FROM=master-jobs@seu-dominio.com

# ---------------------------------------------------------------------------
# PostgreSQL local
#
# Use uma instância local isolada; nunca dados ou credenciais de produção.
# TLS é dispensado apenas em localhost/127.0.0.1/::1.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://<usuario>:<senha>@127.0.0.1:5432/master_jobs_local

# ---------------------------------------------------------------------------
# Cron da Vercel
#
# Protege /api/cron/recheck. SEM ela a rota responde 503 — fechada por omissão,
# porque um cron desprotegido é um botão de disparar requisições contra sites de
# terceiros que qualquer um aperta em laço.
#
# A Vercel envia este valor no cabeçalho `authorization` das chamadas agendadas.
# ---------------------------------------------------------------------------
# CRON_SECRET=

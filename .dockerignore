# Contexto do build da imagem do plano B (Fase 4, ADR 0030). Regra 16: nenhum
# valor versionado do dev entra no contexto — .env* nunca sobe uma camada.
# Espelha .gitignore ("secrets" e "runtime data") de propósito: o que o Git
# nunca versiona, o contexto do build também nunca deveria receber, mesmo que
# alguém o tenha criado localmente sem `git add`. Os padrões de segredo e de
# banco ficam no fim do arquivo (o porquê está lá).
out/
data/

node_modules
.next
.git
.githooks
.github

.claude
# `next build` checa tipos de todo `**/*.ts` do contexto, e
# `scripts/harness/*.ts` importam a política de shell (#470). Só os hooks
# voltam; memória, worktrees, settings, agentes e skills continuam fora.
!.claude/hooks
.codex
.opencode
.agents
.audits
.compozy
.deep-review
.impeccable

.vercel
.playwright-cli
.pnpm-store

coverage
tests
# `scripts/versions/postgres-majors.ts` lê o grafo de módulos dos testes.
!tests/support/module-graph.ts
!tests/support/entry-inventory.ts
docs
compozy
supabase
drizzle
changelog.d
docker
docker-compose.local.yml
.vitest
__pycache__

AGENTS.md
CLAUDE.md
DESIGN.md
MIGRATION.md
PRODUCT.md
README.md

dashboard.html
auth
auth-wal
tsconfig.tsbuildinfo
*.log

# Segredos e banco local, em qualquer profundidade. Ficam por último de
# propósito: a última regra que casa vence, e uma reinclusão acima (como
# `!.claude/hooks`) reabriria um `.env` criado dentro do diretório reincluído.
# O `**/` imita o .gitignore, onde padrão sem barra casa em qualquer nível; no
# Docker, sem ele, o padrão casa só na raiz.
**/.env
**/.env.*
!.env.example
**/*.token.json
**/.linkedin-session.json
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm

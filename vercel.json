{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["iad1"],
  "functions": {
    "app/**": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/recheck",
      "schedule": "0 10 * * *"
    }
  ],
  "ignoredBuildStep": "test \"$VERCEL_GIT_COMMIT_REF\" = \"dev\" -o \"$VERCEL_GIT_COMMIT_REF\" = \"staging\" -o \"$VERCEL_GIT_COMMIT_REF\" = \"main\""
}
